GOOGLE_API_KEY=your-api-key
GOOGLE_MODEL=gemini-3-flash-preview

# RAG Knowledge Base
RAG_KNOWLEDGE_DIR=./knowledge_docs
RAG_QDRANT_COLLECTION_NAME=knowledge_docs
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_TOP_K=3
RAG_RETRIEVAL_MAX_TOP_K=20

# LangSmith Tracing
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=interneers-lab-rag
LANGSMITH_RUNTIME_PROJECT=interneers-lab-rag-runtime
LANGSMITH_EVAL_PROJECT=interneers-lab-rag-eval
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false